{
  "manifest_version": 2,
  "name": "Renskriv",
  "version": "0.1.0",
  "description": "Norwegian PII detection and redaction for safe AI usage",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": ["activeTab"],

  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",

  "background": {
    "scripts": ["src/background.js"],
    "persistent": true
  },

  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "Renskriv — open/close panel"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    "src/wasm/renskriv_wasm_bg.wasm",
    "src/wasm/renskriv_wasm.js"
  ]
}

---
title: Renskriv — Build Targets & Deployment
---

graph LR
    subgraph CORE["🦀 renskriv-core (Rust lib)"]
        PATTERNS["Regex + MOD-11"]
        NER_T["trait NERDetector"]
        GAZ["Gazetteer"]
        CTX["Context Rules"]
        MERGER["Merger"]
    end

    subgraph TARGETS["Kompileringsmål"]
        WASM["wasm32\nwasm-bindgen"]
        NATIVE["native\nx86_64 / aarch64"]
        PYO3["PyO3\nmaturin"]
    end

    subgraph SURFACES["Distribusjonsflater"]
        EXT["🌐 Nettleserutvidelse\nChrome / Firefox"]
        DESKTOP["🖥️ Skrivebordsapp\nTauri"]
        WEBAPP["☁️ Nettapplikasjon\nStreamlit / API"]
        CLI["⌨️ CLI\nrenskriv scan"]
    end

    subgraph NER_IMPL["NER Implementasjoner"]
        CANDLE["Candle / Tract\n(liten modell)"]
        SPACY["SpaCy nb_core_news_lg\n(full nøyaktighet)"]
    end

    CORE --> WASM
    CORE --> NATIVE
    CORE --> PYO3

    WASM --> EXT
    WASM --> WEBAPP
    NATIVE --> DESKTOP
    NATIVE --> CLI
    PYO3 --> WEBAPP
    PYO3 --> DESKTOP

    WASM -.- CANDLE
    NATIVE -.- SPACY
    PYO3 -.- SPACY

    style CORE fill:#1a2332,stroke:#4a9eff,color:#e0e0e0
    style TARGETS fill:#1a1a2e,stroke:#f0883e,color:#e0e0e0
    style SURFACES fill:#1a1a2e,stroke:#56d364,color:#e0e0e0
    style NER_IMPL fill:#1a1a2e,stroke:#bc8cff,color:#e0e0e0

    style WASM fill:#2d1f00,stroke:#f0883e,color:#f0883e
    style NATIVE fill:#0d2818,stroke:#56d364,color:#56d364
    style PYO3 fill:#1f1a2e,stroke:#bc8cff,color:#bc8cff
